<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Biblioteca.Web</RootNamespace>
    <AssemblyName>Biblioteca.Web</AssemblyName>
    <UserSecretsId>biblioteca-web-secrets</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);src/**;tests/**;docs/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="src\Biblioteca.Core\Biblioteca.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Data\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

</Project>
