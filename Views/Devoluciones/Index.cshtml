@model DevolucionesIndexViewModel
@{
    ViewData["Title"] = "Devoluciones";
    ViewData["Descripcion"] = "Registro de devoluciones y control de vencimientos. Al devolver con atraso se genera la multa.";
}

<form method="get" class="mb-4 flex flex-wrap items-center gap-3">
    <input type="text" name="q" value="@Model.Q" class="input sm:max-w-sm" placeholder="Buscar por libro o usuario" />
    <button type="submit" class="btn btn-secondary">Buscar</button>
    <a class="btn btn-enlace" asp-action="Index">Limpiar</a>
    <a class="btn btn-secondary ml-auto" asp-controller="Multas" asp-action="Index">Ver multas</a>
</form>

<div class="tarjeta overflow-hidden">
    <div class="overflow-x-auto">
        <table class="tabla">
            <thead>
                <tr><th>N°</th><th>Libro</th><th>Usuario</th><th>Vence</th><th>Estado</th><th class="text-center">Días atraso</th><th>Multa estimada</th><th class="text-right">Acciones</th></tr>
            </thead>
            <tbody>
            @if (Model.Filas.Count == 0)
            {
                <tr><td colspan="8" class="py-10 text-center text-slate-400">No hay préstamos pendientes de devolución.</td></tr>
            }
            @foreach (var f in Model.Filas)
            {
                var p = f.Prestamo;
                var aviso = p.DiasAtraso > 0 ? $" Tiene {p.DiasAtraso} día(s) de atraso: se generará una multa de Q{f.MultaEstimada:N2}." : "";
                <tr class="@Estilos.FilaPrestamo(p.Estado)">
                    <td class="text-slate-400">@p.Id</td>
                    <td class="min-w-[12rem] font-medium text-slate-900">@p.Libro</td>
                    <td>@p.Usuario</td>
                    <td class="whitespace-nowrap">@p.FechaVencimientoTexto</td>
                    <td><span class="insignia @Estilos.InsigniaPrestamo(p.Estado)">@p.EstadoTexto</span></td>
                    <td class="text-center @(p.DiasAtraso > 0 ? "font-semibold text-red-600" : "")">@p.DiasAtraso</td>
                    <td class="whitespace-nowrap @(p.DiasAtraso > 0 ? "font-semibold text-red-600" : "text-slate-400")">@(p.DiasAtraso > 0 ? "Q" + f.MultaEstimada.ToString("N2") : "—")</td>
                    <td class="whitespace-nowrap text-right">
                        <form method="post" asp-action="Registrar" asp-route-id="@p.Id" class="inline"
                              onsubmit="return confirm('¿Registrar la devolución de «@p.Libro.Replace("'", "\\'")» entregado por @p.Usuario.Replace("'", "\\'")?@aviso');">
                            <button type="submit" class="btn btn-primary btn-sm">Registrar devolución</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<p class="mt-3 text-sm text-slate-500">@Model.Filas.Count pendiente(s) de devolución, @Model.Filas.Count(f => f.Prestamo.DiasAtraso > 0) atrasado(s)</p>
