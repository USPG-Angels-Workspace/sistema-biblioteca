@model DevolucionesIndexViewModel
@{
    ViewData["Title"] = "Devoluciones";
    ViewData["Descripcion"] = "Los libros que siguen afuera. Si vuelve con atraso, la multa se genera al registrar la devolución.";

    // Los atrasados van primero: son los que hay que atender antes.
    var filas = Model.Filas.OrderByDescending(f => f.Prestamo.DiasAtraso).ToList();
    var atrasados = filas.Count(f => f.Prestamo.DiasAtraso > 0);
    var hayFiltros = !string.IsNullOrWhiteSpace(Model.Q);
}

<div class="mb-2 flex flex-wrap items-center justify-between gap-3 border-b border-linea pb-3">
    <form method="get" class="flex flex-wrap items-center gap-2">
        <input type="search" name="q" value="@Model.Q" class="input w-64" placeholder="Título del libro o nombre del usuario" aria-label="Buscar préstamos pendientes" />
        <button type="submit" class="btn btn-secondary">Buscar</button>
        @if (hayFiltros)
        {
            <a class="btn btn-enlace" asp-action="Index">Quitar búsqueda</a>
        }
    </form>
    <a class="enlace" asp-controller="Multas" asp-action="Index">Ver multas</a>
</div>

@if (filas.Count == 0)
{
    <div class="py-16 text-center">
        <p class="font-medium">@(hayFiltros ? "Ningún préstamo pendiente coincide con la búsqueda." : "No hay libros pendientes de devolución.")</p>
        <p class="mt-1 text-suave">@(hayFiltros ? "Pruebe con otro título o nombre." : "Cuando alguien se lleve un libro aparecerá aquí.")</p>
    </div>
}
else
{
    <div class="overflow-x-auto">
        <table class="tabla">
            <thead>
                <tr><th>Libro y lector</th><th>Vencimiento</th><th>Multa al devolver</th><th><span class="sr-only">Acciones</span></th></tr>
            </thead>
            <tbody>
            @foreach (var f in filas)
            {
                var p = f.Prestamo;
                var detalle = $"Lo entrega {p.Usuario}." +
                    (p.DiasAtraso > 0 ? $" Tiene {Textos.Cantidad(p.DiasAtraso, "día", "días")} de atraso: se generará una multa de Q{f.MultaEstimada:N2}." : "");
                <tr>
                    <td class="min-w-[14rem]">
                        <p class="font-medium">@p.Libro</p>
                        <p class="text-suave">@p.Usuario</p>
                    </td>
                    <td class="whitespace-nowrap">
                        @if (p.Estado == EstadoPrestamo.Atrasado)
                        {
                            <p class="@Estilos.EstadoDePrestamo(p.Estado)">@Textos.Vencimiento(p)</p>
                        }
                        else
                        {
                            <p>@Textos.Vencimiento(p)</p>
                        }
                        <p class="text-suave">@p.FechaVencimientoTexto</p>
                    </td>
                    <td class="whitespace-nowrap @(p.DiasAtraso > 0 ? "font-medium" : "text-suave")">@(p.DiasAtraso > 0 ? "Q" + f.MultaEstimada.ToString("N2") : "Sin multa")</td>
                    <td class="whitespace-nowrap text-right">
                        <form method="post" asp-action="Registrar" asp-route-id="@p.Id"
                              data-confirmar="¿Registrar la devolución de «@p.Libro»?"
                              data-detalle="@detalle"
                              data-boton="Registrar devolución">
                            <button type="submit" class="btn @(p.DiasAtraso > 0 ? "btn-primary" : "btn-secondary") btn-sm">Registrar devolución</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <p class="mt-3 text-suave">
        @Textos.Cantidad(filas.Count, "libro pendiente", "libros pendientes") de devolución@(atrasados > 0 ? $", de los cuales {Textos.Cantidad(atrasados, "está atrasado", "están atrasados")}" : "").
    </p>
}
