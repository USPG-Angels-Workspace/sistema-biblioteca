@model DashboardViewModel
@{
    ViewData["Title"] = "Inicio";
    var fecha = DateTime.Today.ToString("dddd, d 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-GT"));
    ViewData["Descripcion"] = char.ToUpper(fecha[0]) + fecha[1..];
    var todoAlDia = Model.PrestamosAtrasados == 0 && Model.MultasPendientes == 0;
}

<div class="mb-8 flex flex-wrap gap-2">
    <a class="btn btn-primary" asp-controller="Prestamos" asp-action="Nuevo">Prestar un libro</a>
    <a class="btn btn-secondary" asp-controller="Devoluciones" asp-action="Index">Recibir una devolución</a>
</div>

@if (todoAlDia)
{
    <p class="mb-8 text-suave">Todo al día: no hay libros atrasados ni multas por cobrar.</p>
}
else
{
    <ul class="mb-8 divide-y divide-linea border-y border-linea">
        @if (Model.PrestamosAtrasados > 0)
        {
            <li class="flex items-center justify-between gap-4 py-2.5">
                <span class="estado estado-rojo">@Textos.Cantidad(Model.PrestamosAtrasados, "libro pasó", "libros pasaron") su fecha de devolución</span>
                <a class="enlace" asp-controller="Prestamos" asp-action="Index" asp-route-estado="Atrasado">Ver atrasados</a>
            </li>
        }
        @if (Model.MultasPendientes > 0)
        {
            <li class="flex items-center justify-between gap-4 py-2.5">
                <span class="estado estado-ambar">Q@(Model.MultasPendientes.ToString("N2")) en multas por cobrar</span>
                <a class="enlace" asp-controller="Multas" asp-action="Index" asp-route-estado="pendientes">Ver multas</a>
            </li>
        }
    </ul>
}

<section aria-labelledby="titulo-vencimientos">
    <div class="mb-1 flex items-baseline justify-between gap-4">
        <h2 id="titulo-vencimientos" class="text-base font-semibold">Próximos vencimientos</h2>
        <a class="enlace" asp-controller="Prestamos" asp-action="Index">Ver todos los préstamos</a>
    </div>
    @if (Model.ProximosVencimientos.Count == 0)
    {
        <p class="border-t border-linea py-8 text-suave">No hay libros pendientes de devolución.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="tabla">
                <thead>
                    <tr><th>Libro y lector</th><th>Vencimiento</th><th><span class="sr-only">Acciones</span></th></tr>
                </thead>
                <tbody>
                @foreach (var p in Model.ProximosVencimientos)
                {
                    var detalle = $"Lo entrega {p.Usuario}." +
                        (p.DiasAtraso > 0 ? $" Tiene {Textos.Cantidad(p.DiasAtraso, "día", "días")} de atraso y se generará una multa." : "");
                    <tr>
                        <td class="min-w-[14rem]">
                            <p class="font-medium">@p.Libro</p>
                            <p class="text-suave">@p.Usuario</p>
                        </td>
                        <td class="whitespace-nowrap">
                            @if (p.Estado == EstadoPrestamo.Atrasado)
                            {
                                <p class="@Estilos.EstadoDePrestamo(p.Estado)">@Textos.Vencimiento(p)</p>
                            }
                            else
                            {
                                <p>@Textos.Vencimiento(p)</p>
                            }
                            <p class="text-suave">@p.FechaVencimientoTexto</p>
                        </td>
                        <td class="whitespace-nowrap text-right">
                            <form method="post" asp-controller="Devoluciones" asp-action="Registrar" asp-route-id="@p.Id"
                                  data-confirmar="¿Registrar la devolución de «@p.Libro»?"
                                  data-detalle="@detalle"
                                  data-boton="Registrar devolución">
                                <button type="submit" class="btn btn-secondary btn-sm">Registrar devolución</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<p class="mt-8 text-suave">
    @Textos.Cantidad(Model.TotalLibros, "título", "títulos") en el catálogo, con @Model.EjemplaresDisponibles de @Textos.Cantidad(Model.TotalEjemplares, "ejemplar", "ejemplares") en estantería.
    @Textos.Cantidad(Model.PrestamosPendientes, "préstamo", "préstamos") sin devolver.
    @Model.UsuariosActivos de @Textos.Cantidad(Model.TotalUsuarios, "usuario", "usuarios") están activos.
</p>

<details class="mt-4 max-w-prose">
    <summary class="cursor-pointer text-suave hover:text-tinta">Reglas del servicio</summary>
    <ul class="mt-2 list-disc space-y-1 pl-5 text-suave">
        <li>Lector: hasta 3 libros a la vez, 7 días de préstamo.</li>
        <li>Bibliotecario: hasta 5 libros, 14 días.</li>
        <li>Hasta @Prestamo.MaximoRenovaciones renovaciones si el préstamo no está vencido.</li>
        <li>Multa de Q@(Biblioteca.Core.Politicas.MultaPorDia.TarifaDiaria.ToString("N2")) por día de atraso, con tope de Q@(Biblioteca.Core.Politicas.MultaPorDia.TopeMaximo.ToString("N2")).</li>
        <li>Con multas pendientes o libros atrasados no se pueden hacer nuevos préstamos.</li>
    </ul>
</details>
