@model LibrosIndexViewModel
@{
    ViewData["Title"] = "Libros";
    ViewData["Descripcion"] = "Registro, edición, búsqueda, clasificación y control de disponibilidad.";
    ViewData["AccionTexto"] = "Nuevo libro";
    ViewData["AccionUrl"] = Url.Action("Crear")!;
}

<form method="get" class="mb-4 flex flex-wrap items-center gap-3">
    <input type="text" name="q" value="@Model.Q" class="input sm:max-w-sm" placeholder="Buscar por título, autor, editorial o ISBN" />
    <select name="categoria" class="input sm:max-w-[13rem]" asp-items="Listas.Categorias(Model.Categoria)">
        <option value="">Todas las categorías</option>
    </select>
    <label class="flex items-center gap-2 text-sm text-slate-600">
        <input type="checkbox" name="soloDisponibles" value="true" checked="@Model.SoloDisponibles" class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
        Solo disponibles
    </label>
    <button type="submit" class="btn btn-secondary">Buscar</button>
    <a class="btn btn-enlace" asp-action="Index">Limpiar</a>
</form>

<div class="tarjeta overflow-hidden">
    <div class="overflow-x-auto">
        <table class="tabla">
            <thead>
                <tr>
                    <th>ISBN</th><th>Título</th><th>Autor</th><th class="hidden 2xl:table-cell">Editorial</th><th>Año</th>
                    <th>Categoría</th><th class="text-center">Ejemplares</th><th>Estado</th><th class="text-right">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Libros.Count == 0)
            {
                <tr><td colspan="9" class="py-10 text-center text-slate-400">No se encontraron libros.</td></tr>
            }
            @foreach (var libro in Model.Libros)
            {
                <tr>
                    <td class="whitespace-nowrap text-slate-500">@libro.Isbn</td>
                    <td class="min-w-[12rem] font-medium text-slate-900">@libro.Titulo</td>
                    <td>@libro.Autor</td>
                    <td class="hidden 2xl:table-cell">@libro.Editorial</td>
                    <td>@libro.Anio</td>
                    <td>@libro.CategoriaTexto</td>
                    <td class="whitespace-nowrap text-center"><span class="font-semibold text-slate-900">@libro.CopiasDisponibles</span> <span class="text-slate-400">/ @libro.CopiasTotales</span></td>
                    <td><span class="insignia @Estilos.InsigniaDisponible(libro.Disponible)">@libro.EstadoTexto</span></td>
                    <td class="whitespace-nowrap text-right"><div class="inline-flex gap-1.5">
                        <a class="btn-icono btn-icono-sec" asp-action="Editar" asp-route-id="@libro.Id" title="Editar" aria-label="Editar"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" /></svg></a>
                        <form method="post" asp-action="Eliminar" asp-route-id="@libro.Id" class="inline"
                              onsubmit="return confirm('¿Eliminar el libro «@libro.Titulo.Replace("'", "\\'")»? Esta acción no se puede deshacer.');">
                            <button type="submit" class="btn-icono btn-icono-peligro" title="Eliminar" aria-label="Eliminar"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg></button>
                        </form></div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<p class="mt-3 text-sm text-slate-500">@Model.Libros.Count libro(s)</p>
