@model LibrosIndexViewModel
@{
    ViewData["Title"] = "Libros";
    ViewData["Descripcion"] = "Registro, edición, búsqueda, clasificación y control de disponibilidad.";
    ViewData["AccionTexto"] = "+ Nuevo libro";
    ViewData["AccionUrl"] = Url.Action("Crear")!;
}

<form method="get" class="row g-2 mb-3 align-items-center">
    <div class="col-md-5">
        <input type="text" name="q" value="@Model.Q" class="form-control" placeholder="Buscar por título, autor, editorial o ISBN" />
    </div>
    <div class="col-md-3">
        <select name="categoria" class="form-select" asp-items="Listas.Categorias(Model.Categoria)">
            <option value="">Todas las categorías</option>
        </select>
    </div>
    <div class="col-auto form-check ms-2">
        <input type="checkbox" class="form-check-input" id="soloDisponibles" name="soloDisponibles" value="true" checked="@Model.SoloDisponibles" />
        <label class="form-check-label" for="soloDisponibles">Solo disponibles</label>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Buscar</button>
        <a class="btn btn-link" asp-action="Index">Limpiar</a>
    </div>
</form>

<div class="tabla-tarjeta">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>ISBN</th><th>Título</th><th>Autor</th><th>Editorial</th><th>Año</th>
                    <th>Categoría</th><th class="text-center">Disp.</th><th class="text-center">Total</th><th>Estado</th><th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Libros.Count == 0)
            {
                <tr><td colspan="10" class="text-center text-secondary py-4">No se encontraron libros.</td></tr>
            }
            @foreach (var libro in Model.Libros)
            {
                <tr>
                    <td class="text-secondary">@libro.Isbn</td>
                    <td class="fw-semibold">@libro.Titulo</td>
                    <td>@libro.Autor</td>
                    <td>@libro.Editorial</td>
                    <td>@libro.Anio</td>
                    <td>@libro.CategoriaTexto</td>
                    <td class="text-center">@libro.CopiasDisponibles</td>
                    <td class="text-center">@libro.CopiasTotales</td>
                    <td><span class="badge @(libro.Disponible ? "text-bg-success" : "text-bg-secondary")">@libro.EstadoTexto</span></td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@libro.Id">Editar</a>
                        <form method="post" asp-action="Eliminar" asp-route-id="@libro.Id" class="d-inline"
                              onsubmit="return confirm('¿Eliminar el libro «@libro.Titulo.Replace("'", "\\'")»? Esta acción no se puede deshacer.');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<p class="text-secondary small mt-2">@Model.Libros.Count libro(s)</p>
