@model LibrosIndexViewModel
@{
    ViewData["Title"] = "Libros";
    ViewData["Descripcion"] = "El catálogo de la biblioteca y cuántos ejemplares quedan en estantería.";
    ViewData["AccionTexto"] = "Nuevo libro";
    ViewData["AccionUrl"] = Url.Action("Crear")!;

    var hayFiltros = !string.IsNullOrWhiteSpace(Model.Q) || Model.Categoria is not null || Model.SoloDisponibles;
    var pestanas = new List<(string Texto, string Url, bool Activa)>
    {
        ("Todos", Url.Action("Index", new { q = Model.Q, categoria = Model.Categoria })!, !Model.SoloDisponibles),
        ("Disponibles ahora", Url.Action("Index", new { q = Model.Q, categoria = Model.Categoria, soloDisponibles = true })!, Model.SoloDisponibles)
    };
}

<div class="mb-2 flex flex-wrap items-end justify-between gap-x-6 gap-y-3 border-b border-linea">
    <partial name="_Pestanas" model="pestanas" />
    <form method="get" class="flex flex-wrap items-center gap-2 pb-2">
        @if (Model.SoloDisponibles)
        {
            <input type="hidden" name="soloDisponibles" value="true" />
        }
        <input type="search" name="q" value="@Model.Q" class="input w-64" placeholder="Título, autor, editorial o ISBN" aria-label="Buscar libros" />
        <select name="categoria" class="input w-auto" aria-label="Categoría" data-autoenviar asp-items="Listas.Categorias(Model.Categoria)">
            <option value="">Todas las categorías</option>
        </select>
        <button type="submit" class="btn btn-secondary">Buscar</button>
    </form>
</div>

@if (Model.Libros.Count == 0)
{
    <div class="py-16 text-center">
        <p class="font-medium">@(hayFiltros ? "Ningún libro coincide con la búsqueda." : "Todavía no hay libros registrados.")</p>
        <p class="mt-1 text-suave">@(hayFiltros ? "Pruebe con otras palabras o quite los filtros." : "Registre el primero para poder prestarlo.")</p>
        @if (hayFiltros)
        {
            <a class="btn btn-secondary mt-4" asp-action="Index">Quitar filtros</a>
        }
        else
        {
            <a class="btn btn-primary mt-4" asp-action="Crear">Registrar un libro</a>
        }
    </div>
}
else
{
    <div class="overflow-x-auto">
        <table class="tabla">
            <thead>
                <tr><th>Libro</th><th>Categoría</th><th class="hidden lg:table-cell">Publicación</th><th>Disponibilidad</th><th><span class="sr-only">Acciones</span></th></tr>
            </thead>
            <tbody>
            @foreach (var libro in Model.Libros)
            {
                <tr>
                    <td class="min-w-[14rem]">
                        <p class="font-medium">@libro.Titulo</p>
                        <p class="text-suave">@libro.Autor</p>
                    </td>
                    <td class="whitespace-nowrap">@libro.CategoriaTexto</td>
                    <td class="hidden lg:table-cell">
                        <p>@libro.Editorial, @libro.Anio</p>
                        <p class="text-suave">ISBN @libro.Isbn</p>
                    </td>
                    <td class="whitespace-nowrap">
                        <span class="estado @(libro.Disponible ? "estado-verde" : "estado-gris")">@(libro.Disponible ? $"{libro.CopiasDisponibles} de {libro.CopiasTotales} disponibles" : "Sin ejemplares")</span>
                    </td>
                    <td class="whitespace-nowrap text-right">
                        <div class="inline-flex gap-0.5">
                            <a class="btn-icono" asp-action="Editar" asp-route-id="@libro.Id" title="Editar" aria-label="Editar @libro.Titulo"><svg class="h-[18px] w-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" /></svg></a>
                            <form method="post" asp-action="Eliminar" asp-route-id="@libro.Id"
                                  data-confirmar="¿Eliminar el libro «@libro.Titulo»?"
                                  data-detalle="Esta acción no se puede deshacer."
                                  data-boton="Eliminar libro" data-peligro="true">
                                <button type="submit" class="btn-icono btn-icono-peligro" title="Eliminar" aria-label="Eliminar @libro.Titulo"><svg class="h-[18px] w-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg></button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <p class="mt-3 text-suave">
        @Textos.Cantidad(Model.Libros.Count, "libro", "libros")@(hayFiltros ? " con estos filtros." : ".")
        @if (hayFiltros)
        {
            <a class="enlace" asp-action="Index">Quitar filtros</a>
        }
    </p>
}
