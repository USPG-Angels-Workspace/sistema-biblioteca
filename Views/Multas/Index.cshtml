@model MultasIndexViewModel
@{
    ViewData["Title"] = "Multas";
    ViewData["Descripcion"] = "Control y cobro de las multas generadas por devoluciones con atraso.";
}

<form method="get" class="mb-4 flex flex-wrap items-center gap-3">
    <input type="text" name="q" value="@Model.Q" class="input sm:max-w-sm" placeholder="Buscar por usuario o libro" />
    <select name="estado" class="input sm:max-w-[13rem]">
        <option value="" selected="@string.IsNullOrEmpty(Model.Estado)">Todas las multas</option>
        <option value="pendientes" selected="@(Model.Estado == "pendientes")">Pendientes de pago</option>
        <option value="pagadas" selected="@(Model.Estado == "pagadas")">Pagadas</option>
    </select>
    <button type="submit" class="btn btn-secondary">Buscar</button>
    <a class="btn btn-enlace" asp-action="Index">Limpiar</a>
</form>

<div class="tarjeta overflow-hidden">
    <div class="overflow-x-auto">
        <table class="tabla">
            <thead>
                <tr><th>N°</th><th>Usuario</th><th>Libro</th><th class="text-center">Días atraso</th><th>Monto</th><th>Generada</th><th>Estado</th><th>Pagada el</th><th class="text-right">Acciones</th></tr>
            </thead>
            <tbody>
            @if (Model.Multas.Count == 0)
            {
                <tr><td colspan="9" class="py-10 text-center text-slate-400">No se encontraron multas.</td></tr>
            }
            @foreach (var m in Model.Multas)
            {
                <tr class="@(m.Pagada ? "text-slate-400" : "")">
                    <td class="text-slate-400">@m.Id</td>
                    <td class="font-medium @(m.Pagada ? "" : "text-slate-900")">@m.Usuario</td>
                    <td>@m.Libro</td>
                    <td class="text-center">@m.DiasAtraso</td>
                    <td class="whitespace-nowrap font-semibold">@m.MontoTexto</td>
                    <td class="whitespace-nowrap">@m.FechaGeneracionTexto</td>
                    <td><span class="insignia @Estilos.InsigniaMulta(m.Pagada)">@m.EstadoTexto</span></td>
                    <td class="whitespace-nowrap">@m.FechaPagoTexto</td>
                    <td class="whitespace-nowrap text-right">
                        @if (!m.Pagada)
                        {
                            <form method="post" asp-action="Pagar" asp-route-id="@m.Id" class="inline"
                                  onsubmit="return confirm('¿Registrar el pago de @m.MontoTexto de @m.Usuario.Replace("'", "\\'")?');">
                                <button type="submit" class="btn btn-primary btn-sm">Registrar pago</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<p class="mt-3 text-sm text-slate-500">@Model.Multas.Count multa(s) — pendiente de cobro en esta lista: Q@(Model.Multas.Where(m => !m.Pagada).Sum(m => m.Monto).ToString("N2"))</p>
