@model PrestamosIndexViewModel
@{
    ViewData["Title"] = "Préstamos";
    ViewData["Descripcion"] = "Registro de préstamos, asignación de libros, fechas de devolución y renovaciones.";
    ViewData["AccionTexto"] = "Nuevo préstamo";
    ViewData["AccionUrl"] = Url.Action("Nuevo")!;
}

<form method="get" class="mb-4 flex flex-wrap items-center gap-3">
    <input type="text" name="q" value="@Model.Q" class="input sm:max-w-sm" placeholder="Buscar por libro o usuario" />
    <select name="estado" class="input sm:max-w-[13rem]">
        <option value="" selected="@(Model.Estado is null)">Todos los estados</option>
        <option value="Activo" selected="@(Model.Estado == EstadoPrestamo.Activo)">Activos</option>
        <option value="Atrasado" selected="@(Model.Estado == EstadoPrestamo.Atrasado)">Atrasados</option>
        <option value="Devuelto" selected="@(Model.Estado == EstadoPrestamo.Devuelto)">Devueltos</option>
    </select>
    <button type="submit" class="btn btn-secondary">Buscar</button>
    <a class="btn btn-enlace" asp-action="Index">Limpiar</a>
</form>

<div class="tarjeta overflow-hidden">
    <div class="overflow-x-auto">
        <table class="tabla">
            <thead>
                <tr><th>N°</th><th>Libro</th><th>Usuario</th><th class="hidden 2xl:table-cell">Préstamo</th><th>Vence</th><th>Devuelto</th><th class="text-center">Renov.</th><th class="text-center">Atraso</th><th>Estado</th><th class="text-right">Acciones</th></tr>
            </thead>
            <tbody>
            @if (Model.Prestamos.Count == 0)
            {
                <tr><td colspan="10" class="py-10 text-center text-slate-400">No se encontraron préstamos.</td></tr>
            }
            @foreach (var p in Model.Prestamos)
            {
                <tr class="@Estilos.FilaPrestamo(p.Estado)">
                    <td class="text-slate-400">@p.Id</td>
                    <td class="min-w-[12rem] font-medium @(p.Estado == EstadoPrestamo.Devuelto ? "" : "text-slate-900")">@p.Libro</td>
                    <td>@p.Usuario</td>
                    <td class="hidden whitespace-nowrap 2xl:table-cell">@p.FechaPrestamoTexto</td>
                    <td class="whitespace-nowrap @(p.Estado == EstadoPrestamo.Atrasado ? "font-semibold text-red-600" : "")">@p.FechaVencimientoTexto</td>
                    <td class="whitespace-nowrap">@p.FechaDevolucionTexto</td>
                    <td class="text-center">@p.Renovaciones</td>
                    <td class="text-center @(p.DiasAtraso > 0 && p.Estado == EstadoPrestamo.Atrasado ? "font-semibold text-red-600" : "")">@p.DiasAtraso</td>
                    <td><span class="insignia @Estilos.InsigniaPrestamo(p.Estado)">@p.EstadoTexto</span></td>
                    <td class="whitespace-nowrap text-right">
                        @if (p.Estado == EstadoPrestamo.Activo)
                        {
                            <form method="post" asp-action="Renovar" asp-route-id="@p.Id" class="inline"
                                  onsubmit="return confirm('¿Renovar el préstamo de «@p.Libro.Replace("'", "\\'")» a nombre de @p.Usuario.Replace("'", "\\'")?');">
                                <button type="submit" class="btn btn-secondary btn-sm">Renovar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<p class="mt-3 text-sm text-slate-500">@Model.Prestamos.Count préstamo(s)</p>
