@model PrestamosIndexViewModel
@{
    ViewData["Title"] = "Préstamos";
    ViewData["Descripcion"] = "Qué libros están afuera, quién los tiene y cuándo deben volver.";
    ViewData["AccionTexto"] = "Nuevo préstamo";
    ViewData["AccionUrl"] = Url.Action("Nuevo")!;

    var hayFiltros = !string.IsNullOrWhiteSpace(Model.Q) || Model.Estado is not null;
    var pestanas = new List<(string Texto, string Url, bool Activa)>
    {
        ("Todos", Url.Action("Index", new { q = Model.Q })!, Model.Estado is null),
        ("Activos", Url.Action("Index", new { q = Model.Q, estado = "Activo" })!, Model.Estado == EstadoPrestamo.Activo),
        ("Atrasados", Url.Action("Index", new { q = Model.Q, estado = "Atrasado" })!, Model.Estado == EstadoPrestamo.Atrasado),
        ("Devueltos", Url.Action("Index", new { q = Model.Q, estado = "Devuelto" })!, Model.Estado == EstadoPrestamo.Devuelto)
    };
}

<div class="mb-2 flex flex-wrap items-end justify-between gap-x-6 gap-y-3 border-b border-linea">
    <partial name="_Pestanas" model="pestanas" />
    <form method="get" class="flex flex-wrap items-center gap-2 pb-2">
        @if (Model.Estado is not null)
        {
            <input type="hidden" name="estado" value="@Model.Estado" />
        }
        <input type="search" name="q" value="@Model.Q" class="input w-64" placeholder="Título del libro o nombre del usuario" aria-label="Buscar préstamos" />
        <button type="submit" class="btn btn-secondary">Buscar</button>
    </form>
</div>

@if (Model.Prestamos.Count == 0)
{
    <div class="py-16 text-center">
        <p class="font-medium">@(hayFiltros ? "Ningún préstamo coincide con la búsqueda." : "Todavía no hay préstamos.")</p>
        @if (hayFiltros)
        {
            <a class="btn btn-secondary mt-4" asp-action="Index">Quitar filtros</a>
        }
        else
        {
            <a class="btn btn-primary mt-4" asp-action="Nuevo">Registrar el primer préstamo</a>
        }
    </div>
}
else
{
    <div class="overflow-x-auto">
        <table class="tabla">
            <thead>
                <tr><th>Libro y lector</th><th>Estado</th><th>Fecha de devolución</th><th>Renovaciones</th><th><span class="sr-only">Acciones</span></th></tr>
            </thead>
            <tbody>
            @foreach (var p in Model.Prestamos)
            {
                <tr class="@Estilos.FilaPrestamo(p.Estado)">
                    <td class="min-w-[14rem]">
                        <p class="font-medium">@p.Libro</p>
                        <p class="text-suave">@p.Usuario</p>
                    </td>
                    <td class="whitespace-nowrap">
                        <p class="@Estilos.EstadoDePrestamo(p.Estado)">@p.EstadoTexto</p>
                        <p class="@(p.Estado == EstadoPrestamo.Atrasado ? "text-rojo" : "text-suave")">@Textos.Vencimiento(p)</p>
                    </td>
                    <td class="whitespace-nowrap">
                        <p>@p.FechaVencimientoTexto</p>
                        <p class="text-suave">Prestado el @p.FechaPrestamoTexto</p>
                    </td>
                    <td class="whitespace-nowrap">@p.Renovaciones de @Prestamo.MaximoRenovaciones</td>
                    <td class="whitespace-nowrap text-right">
                        @if (p.Estado == EstadoPrestamo.Activo && p.Renovaciones < Prestamo.MaximoRenovaciones)
                        {
                            <form method="post" asp-action="Renovar" asp-route-id="@p.Id"
                                  data-confirmar="¿Renovar el préstamo de «@p.Libro»?"
                                  data-detalle="Está a nombre de @p.Usuario. La fecha de devolución se extiende."
                                  data-boton="Renovar préstamo">
                                <button type="submit" class="btn btn-secondary btn-sm">Renovar</button>
                            </form>
                        }
                        else if (p.Estado == EstadoPrestamo.Activo)
                        {
                            <span class="text-suave">Ya no se puede renovar</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <p class="mt-3 text-suave">
        @Textos.Cantidad(Model.Prestamos.Count, "préstamo", "préstamos")@(hayFiltros ? " con estos filtros." : ".")
        @if (hayFiltros)
        {
            <a class="enlace" asp-action="Index">Quitar filtros</a>
        }
    </p>
}
