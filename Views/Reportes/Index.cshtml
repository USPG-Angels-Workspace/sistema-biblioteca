@model ReportesIndexViewModel
@{
    ViewData["Title"] = "Reportes";
    ViewData["Descripcion"] = "Libros disponibles, préstamos activos, libros atrasados, usuarios y multas.";
}

<div class="mb-4 flex flex-wrap items-center gap-2">
    <div class="inline-flex flex-wrap gap-1 rounded-xl border border-slate-200 bg-white p-1 shadow-sm">
        @foreach (var (clave, nombre) in Model.Opciones)
        {
            <a class="rounded-lg px-3.5 py-2 text-sm font-medium transition @(clave == Model.Clave ? "bg-indigo-600 text-white shadow-sm" : "text-slate-600 hover:bg-slate-100")"
               asp-action="Index" asp-route-id="@clave">@nombre</a>
        }
    </div>
    <a class="btn btn-secondary ml-auto" asp-action="Exportar" asp-route-id="@Model.Clave">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
        Exportar a CSV
    </a>
</div>

<div class="tarjeta overflow-hidden">
    <div class="overflow-x-auto">
        <table class="tabla">
            <thead>
                <tr>
                    @foreach (var columna in Model.Reporte.Columnas)
                    {
                        <th>@columna</th>
                    }
                </tr>
            </thead>
            <tbody>
            @if (Model.Reporte.Filas.Count == 0)
            {
                <tr><td colspan="@Model.Reporte.Columnas.Count" class="py-10 text-center text-slate-400">El reporte no tiene datos.</td></tr>
            }
            @foreach (var fila in Model.Reporte.Filas)
            {
                <tr>
                    @foreach (var celda in fila)
                    {
                        <td>@celda</td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<p class="mt-4 rounded-lg bg-white px-4 py-3 text-sm font-medium text-slate-700 shadow-sm ring-1 ring-slate-200">@Model.Reporte.Resumen</p>
