@model ReportesIndexViewModel
@{
    ViewData["Title"] = "Reportes";
    ViewData["Descripcion"] = "Libros disponibles, préstamos activos, libros atrasados, usuarios y multas.";
}

<div class="d-flex flex-wrap gap-2 mb-3">
    @foreach (var (clave, nombre) in Model.Opciones)
    {
        <a class="btn @(clave == Model.Clave ? "btn-primary" : "btn-outline-primary")" asp-action="Index" asp-route-id="@clave">@nombre</a>
    }
    <a class="btn btn-outline-secondary ms-auto" asp-action="Exportar" asp-route-id="@Model.Clave">Exportar a CSV</a>
</div>

<div class="tabla-tarjeta">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    @foreach (var columna in Model.Reporte.Columnas)
                    {
                        <th>@columna</th>
                    }
                </tr>
            </thead>
            <tbody>
            @if (Model.Reporte.Filas.Count == 0)
            {
                <tr><td colspan="@Model.Reporte.Columnas.Count" class="text-center text-secondary py-4">El reporte no tiene datos.</td></tr>
            }
            @foreach (var fila in Model.Reporte.Filas)
            {
                <tr>
                    @foreach (var celda in fila)
                    {
                        <td>@celda</td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<p class="fw-semibold mt-3">@Model.Reporte.Resumen</p>
