@model ReportesIndexViewModel
@{
    ViewData["Title"] = "Reportes";
    ViewData["Descripcion"] = "Elija un reporte para verlo aquí o descargarlo y abrirlo en una hoja de cálculo.";
    var pestanas = Model.Opciones
        .Select(o => (Texto: o.Nombre, Url: Url.Action("Index", new { id = o.Clave })!, Activa: o.Clave == Model.Clave))
        .ToList();
}

<div class="mb-2 flex flex-wrap items-end justify-between gap-x-6 gap-y-3 border-b border-linea">
    <partial name="_Pestanas" model="pestanas" />
    <a class="btn btn-secondary mb-2" asp-action="Exportar" asp-route-id="@Model.Clave">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
        Descargar CSV
    </a>
</div>

<div class="overflow-x-auto">
    <table class="tabla">
        <thead>
            <tr>
                @foreach (var columna in Model.Reporte.Columnas)
                {
                    <th>@columna</th>
                }
            </tr>
        </thead>
        <tbody>
        @if (Model.Reporte.Filas.Count == 0)
        {
            <tr><td colspan="@Model.Reporte.Columnas.Count" class="py-12 text-center text-suave">Este reporte no tiene datos por ahora.</td></tr>
        }
        @foreach (var fila in Model.Reporte.Filas)
        {
            <tr>
                @foreach (var celda in fila)
                {
                    <td>@celda</td>
                }
            </tr>
        }
        </tbody>
    </table>
</div>
<p class="mt-3 font-medium">@Model.Reporte.Resumen</p>
