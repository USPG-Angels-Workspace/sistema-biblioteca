@model ErrorViewModel
@{
    ViewData["Title"] = "Algo salió mal";
}

<div class="max-w-xl rounded-md border border-rojo/30 bg-rojo-claro p-5">
    <p class="font-medium">No se pudo completar la solicitud.</p>
    <p class="mt-1 text-suave">Vuelva al <a class="enlace" asp-controller="Home" asp-action="Index">inicio</a> e intente de nuevo.</p>
    @if (Model.ShowRequestId)
    {
        <p class="mt-3 text-xs text-suave">Identificador de la solicitud: <code>@Model.RequestId</code></p>
    }
</div>
