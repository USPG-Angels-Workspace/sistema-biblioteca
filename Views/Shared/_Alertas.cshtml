@*
    Mensajes de una sola vez (TempData): verde para exito, rojo para error.
    El boton de la derecha los cierra.
*@
@if (TempData["Mensaje"] is string mensajeExito)
{
    <div class="mb-6 flex items-start gap-2.5 rounded-md border border-verde/30 bg-verde-claro px-3.5 py-2.5" role="status">
        <svg class="mt-0.5 h-4 w-4 shrink-0 text-verde" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" /></svg>
        <p class="flex-1">@mensajeExito</p>
        <button type="button" class="text-suave hover:text-tinta" aria-label="Cerrar mensaje" onclick="this.parentElement.remove()">&times;</button>
    </div>
}
@if (TempData["Error"] is string mensajeError)
{
    <div class="mb-6 flex items-start gap-2.5 rounded-md border border-rojo/30 bg-rojo-claro px-3.5 py-2.5" role="alert">
        <svg class="mt-0.5 h-4 w-4 shrink-0 text-rojo" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" /></svg>
        <p class="flex-1">@mensajeError</p>
        <button type="button" class="text-suave hover:text-tinta" aria-label="Cerrar mensaje" onclick="this.parentElement.remove()">&times;</button>
    </div>
}
