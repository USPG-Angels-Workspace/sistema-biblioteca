@*
    Layout compartido: menu lateral con los modulos, encabezado de la pagina, mensajes
    (TempData) y el cuerpo de cada vista. Estilos con Tailwind CSS (CDN); las clases
    reutilizables (btn, input, card, tabla, ...) se definen abajo con @apply.
*@
@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    string Clase(string nombre) =>
        controlador.Equals(nombre, StringComparison.OrdinalIgnoreCase)
            ? "flex items-center gap-3 rounded-lg bg-indigo-600 px-3 py-2.5 text-sm font-medium text-white shadow-sm"
            : "flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-300 transition hover:bg-slate-800 hover:text-white";

    var iconos = new Dictionary<string, string>
    {
        ["Home"] = "M2.25 12l8.954-8.955a1.126 1.126 0 011.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25",
        ["Libros"] = "M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25",
        ["Usuarios"] = "M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z",
        ["Prestamos"] = "M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5",
        ["Devoluciones"] = "M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3",
        ["Multas"] = "M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
        ["Reportes"] = "M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"
    };

    var enlaces = new[]
    {
        ("Home", "Inicio", "Home", "Index"),
        ("Libros", "Libros", "Libros", "Index"),
        ("Usuarios", "Usuarios", "Usuarios", "Index"),
        ("Prestamos", "Préstamos", "Prestamos", "Index"),
        ("Devoluciones", "Devoluciones", "Devoluciones", "Index"),
        ("Multas", "Multas", "Multas", "Index"),
        ("Reportes", "Reportes", "Reportes", "Index")
    };
}
<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biblioteca</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: { extend: { fontFamily: { sans: ['Inter', 'ui-sans-serif', 'system-ui', 'Segoe UI', 'sans-serif'] } } }
        };
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style type="text/tailwindcss">
        @@layer components {
            .btn { @@apply inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-medium transition focus:outline-none focus:ring-2 focus:ring-offset-1 disabled:opacity-50; }
            .btn-sm { @@apply px-3 py-1.5 text-xs; }
            .btn-primary { @@apply bg-indigo-600 text-white shadow-sm hover:bg-indigo-700 focus:ring-indigo-500; }
            .btn-secondary { @@apply border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 focus:ring-slate-400; }
            .btn-danger { @@apply border border-red-200 bg-white text-red-600 hover:bg-red-50 focus:ring-red-400; }
            .btn-icono { @@apply inline-flex h-8 w-8 items-center justify-center rounded-lg border bg-white transition focus:outline-none focus:ring-2 focus:ring-offset-1; }
            .btn-icono-sec { @@apply border-slate-300 text-slate-600 hover:bg-slate-50 hover:text-slate-900 focus:ring-slate-400; }
            .btn-icono-peligro { @@apply border-red-200 text-red-600 hover:bg-red-50 focus:ring-red-400; }
            .btn-enlace { @@apply px-2 text-slate-500 hover:text-slate-800; }
            .input { @@apply block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500; }
            .etiqueta { @@apply mb-1.5 block text-sm font-medium text-slate-700; }
            .error-campo { @@apply mt-1 block text-xs text-red-600; }
            .resumen-errores { @@apply mb-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700; }
            .resumen-errores ul { @@apply list-disc space-y-1 pl-5; }
            .tarjeta { @@apply rounded-xl border border-slate-200 bg-white shadow-sm; }
            .tabla { @@apply min-w-full divide-y divide-slate-200 text-sm; }
            .tabla thead { @@apply bg-slate-50; }
            .tabla th { @@apply whitespace-nowrap px-3 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500; }
            .tabla td { @@apply px-3 py-3 align-middle text-slate-700; }
            .tabla tbody { @@apply divide-y divide-slate-100; }
            .tabla tbody tr { @@apply transition hover:bg-slate-50; }
            .insignia { @@apply inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset; }
            .titulo-tarjeta { @@apply text-sm font-semibold text-slate-800; }
            .input-validation-error { @@apply border-red-400; }
        }
    </style>
    <link rel="icon" href="data:," />
</head>
<body class="h-full bg-slate-50 font-sans text-slate-800 antialiased">
    <div class="min-h-full lg:flex">
        <div class="flex items-center justify-between bg-slate-900 px-4 py-3 text-white lg:hidden">
            <span class="text-lg font-bold">Biblioteca</span>
            <button type="button" id="botonMenu" class="rounded-lg p-2 hover:bg-slate-800" aria-label="Abrir menú">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" /></svg>
            </button>
        </div>

        <aside id="menu" class="hidden shrink-0 flex-col bg-slate-900 lg:sticky lg:top-0 lg:flex lg:h-screen lg:w-64">
            <div class="flex items-center gap-3 px-5 py-6">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-500 text-white">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="@iconos["Libros"]" /></svg>
                </div>
                <div class="leading-tight">
                    <p class="text-lg font-bold text-white">Biblioteca</p>
                    <p class="text-xs text-slate-400">Sistema de gestión</p>
                </div>
            </div>
            <nav class="flex-1 space-y-1 px-3">
                @foreach (var (icono, texto, ctrl, accion) in enlaces)
                {
                    <a class="@Clase(ctrl)" asp-controller="@ctrl" asp-action="@accion">
                        <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="@iconos[icono]" /></svg>
                        <span>@texto</span>
                    </a>
                }
            </nav>
            <div class="border-t border-slate-800 px-5 py-4 text-xs text-slate-500">
                Programación II · Proyecto 1<br />Universidad San Pablo de Guatemala
            </div>
        </aside>

        <div class="min-w-0 flex-1">
            <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
                <header class="mb-6 flex flex-wrap items-start justify-between gap-4">
                    <div>
                        <h1 class="text-2xl font-bold tracking-tight text-slate-900">@ViewData["Title"]</h1>
                        @if (ViewData["Descripcion"] is string descripcion)
                        {
                            <p class="mt-1 text-sm text-slate-500">@descripcion</p>
                        }
                    </div>
                    @if (ViewData["AccionTexto"] is string accionTexto && ViewData["AccionUrl"] is string accionUrl)
                    {
                        <a class="btn btn-primary whitespace-nowrap" href="@accionUrl">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                            @accionTexto
                        </a>
                    }
                </header>

                <partial name="_Alertas" />

                @RenderBody()
            </main>
        </div>
    </div>

    <script>
        document.getElementById('botonMenu').addEventListener('click', function () {
            var menu = document.getElementById('menu');
            menu.classList.toggle('hidden');
            menu.classList.toggle('flex');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
