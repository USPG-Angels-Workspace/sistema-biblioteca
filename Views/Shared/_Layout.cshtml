@*
    Layout compartido: panel administrativo con menu lateral (modulos agrupados por tarea),
    encabezado de la pagina, mensajes (TempData), dialogo de confirmacion y el cuerpo de cada vista.
    Estilos con Tailwind CSS (CDN); los colores propios (tinta, acento, rojo...) se declaran en
    tailwind.config y las clases reutilizables (btn, input, tabla, estado, ...) abajo con @apply.
*@
@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    bool Activo(string nombre) => controlador.Equals(nombre, StringComparison.OrdinalIgnoreCase);

    var iconos = new Dictionary<string, string>
    {
        ["Home"] = "M2.25 12l8.954-8.955a1.126 1.126 0 011.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25",
        ["Libros"] = "M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25",
        ["Usuarios"] = "M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z",
        ["Prestamos"] = "M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5",
        ["Devoluciones"] = "M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3",
        ["Multas"] = "M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
        ["Reportes"] = "M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"
    };

    // Los modulos se agrupan por lo que la persona esta haciendo; una linea separa cada grupo.
    var grupos = new[]
    {
        new[] { ("Home", "Inicio", "Home") },
        new[] { ("Prestamos", "Préstamos", "Prestamos"), ("Devoluciones", "Devoluciones", "Devoluciones"), ("Multas", "Multas", "Multas") },
        new[] { ("Libros", "Libros", "Libros"), ("Usuarios", "Usuarios", "Usuarios") },
        new[] { ("Reportes", "Reportes", "Reportes") }
    };
}
<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biblioteca</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['"IBM Plex Sans"', 'ui-sans-serif', 'system-ui', 'Segoe UI', 'sans-serif'] },
                    colors: {
                        tinta: '#1F2328',
                        suave: '#656D76',
                        linea: '#E3E5E8',
                        borde: '#CDD1D6',
                        lateral: '#F6F7F8',
                        acento: { DEFAULT: '#2B4C7E', oscuro: '#213B62', claro: '#EEF2F8' },
                        rojo: { DEFAULT: '#B42318', claro: '#FEF1EF' },
                        ambar: { DEFAULT: '#8A5A00', claro: '#FFF6E0' },
                        verde: { DEFAULT: '#1A7F4B', claro: '#EDF7F1' }
                    }
                }
            }
        };
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <style type="text/tailwindcss">
        @@layer base {
            body { font-variant-numeric: tabular-nums; }
            :focus-visible { outline: 2px solid theme('colors.acento.DEFAULT'); outline-offset: 2px; }
        }
        @@layer components {
            .nav-item { @@apply flex items-center gap-2.5 rounded-r-md border-l-2 border-transparent py-1.5 pl-[1.125rem] pr-3 text-suave transition-colors hover:text-tinta; }
            .nav-item-activo { @@apply border-acento bg-white font-medium text-tinta; }

            .btn { @@apply inline-flex items-center justify-center gap-1.5 whitespace-nowrap rounded-md px-3.5 py-1.5 text-sm font-medium transition-colors disabled:cursor-not-allowed disabled:opacity-45; }
            .btn-sm { @@apply px-2.5 py-1 text-[0.8125rem]; }
            .btn-primary { @@apply bg-acento text-white hover:bg-acento-oscuro; }
            .btn-secondary { @@apply border border-borde bg-white text-tinta hover:bg-lateral; }
            .btn-peligro { @@apply bg-rojo text-white hover:opacity-90; }
            .btn-enlace { @@apply px-2 text-suave underline-offset-4 hover:text-tinta hover:underline; }
            .btn-icono { @@apply inline-flex h-8 w-8 items-center justify-center rounded-md text-suave transition-colors hover:bg-lateral hover:text-tinta; }
            .btn-icono-peligro { @@apply hover:bg-rojo-claro hover:text-rojo; }
            .enlace { @@apply text-acento underline-offset-4 hover:underline; }

            .input { @@apply block w-full rounded-md border border-borde bg-white px-3 py-1.5 text-sm text-tinta placeholder-suave/70 focus:border-acento focus:outline-none focus:ring-1 focus:ring-acento; }
            .etiqueta { @@apply mb-1 block text-sm font-medium; }
            .ayuda { @@apply mt-1 block text-xs text-suave; }
            .error-campo { @@apply mt-1 block text-xs text-rojo; }
            .input-validation-error { @@apply border-rojo; }
            .resumen-errores { @@apply mb-6 rounded-md border border-rojo/30 bg-rojo-claro px-4 py-3 text-sm; }
            .resumen-errores ul { @@apply list-disc space-y-1 pl-5; }
            .validation-summary-valid { @@apply hidden; }

            .tabla { @@apply w-full text-sm; }
            .tabla th { @@apply whitespace-nowrap border-b border-linea px-3 py-2 text-left text-[0.8125rem] font-medium text-suave; }
            .tabla td { @@apply border-b border-linea px-3 py-3 align-top; }
            .tabla th:first-child, .tabla td:first-child { padding-left: 0; }
            .tabla th:last-child, .tabla td:last-child { padding-right: 0; }

            .estado { @@apply inline-flex items-center gap-1.5 whitespace-nowrap; }
            .estado::before { content: ''; @@apply h-1.5 w-1.5 shrink-0 rounded-full; background-color: var(--punto); }
            .estado-verde { --punto: #1A7F4B; }
            .estado-rojo { --punto: #B42318; }
            .estado-ambar { --punto: #C98A00; }
            .estado-gris { --punto: #A0A7AF; }

            .pestana { @@apply -mb-px border-b-2 border-transparent pb-2 pt-1 text-sm text-suave hover:text-tinta; }
            .pestana-activa { @@apply border-acento font-medium text-tinta; }

            .opcion-lista { @@apply block cursor-pointer px-3 py-2 text-sm hover:bg-lateral peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:-outline-offset-2 peer-focus-visible:outline-acento; }
            .peer:checked + .opcion-lista { background-color: theme('colors.acento.claro'); box-shadow: inset 2px 0 0 theme('colors.acento.DEFAULT'); }
        }
        dialog[open] { animation: aparecer 0.15s ease-out; }
        @@keyframes aparecer { from { opacity: 0; transform: translateY(4px); } }
        @@media (prefers-reduced-motion: reduce) { dialog[open] { animation: none; } }
    </style>
    <link rel="icon" href="data:," />
</head>
<body class="h-full bg-white font-sans text-sm text-tinta antialiased">
    <div class="min-h-full lg:flex">
        <div class="flex items-center justify-between border-b border-linea bg-lateral px-4 py-2.5 lg:hidden">
            <span class="font-semibold">Biblioteca</span>
            <button type="button" id="botonMenu" class="rounded-md p-1.5 text-suave hover:text-tinta" aria-label="Abrir menú" aria-controls="menu" aria-expanded="false">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" /></svg>
            </button>
        </div>

        <aside id="menu" class="hidden shrink-0 flex-col border-r border-linea bg-lateral lg:sticky lg:top-0 lg:flex lg:h-screen lg:w-56">
            <div class="px-5 pb-4 pt-6">
                <p class="text-[0.9375rem] font-semibold">Biblioteca</p>
                <p class="text-xs text-suave">Universidad San Pablo</p>
            </div>
            <nav class="flex-1 overflow-y-auto pr-3" aria-label="Principal">
                @for (var g = 0; g < grupos.Length; g++)
                {
                    if (g > 0)
                    {
                        <hr class="my-2 ml-5 border-linea" />
                    }
                    foreach (var (icono, texto, ctrl) in grupos[g])
                    {
                        <a class="nav-item @(Activo(ctrl) ? "nav-item-activo" : "")" asp-controller="@ctrl" asp-action="Index"
                           aria-current="@(Activo(ctrl) ? "page" : null)">
                            <svg class="h-[18px] w-[18px] shrink-0 @(Activo(ctrl) ? "text-acento" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="@iconos[icono]" /></svg>
                            @texto
                        </a>
                    }
                }
            </nav>
            <p class="px-5 py-4 text-xs text-suave">Programación II</p>
        </aside>

        <main class="min-w-0 flex-1">
            <div class="mx-auto max-w-6xl px-4 py-8 sm:px-8">
                <header class="mb-6 flex flex-wrap items-start justify-between gap-3">
                    <div>
                        <h1 class="text-xl font-semibold tracking-tight">@ViewData["Title"]</h1>
                        @if (ViewData["Descripcion"] is string descripcion)
                        {
                            <p class="mt-0.5 max-w-prose text-suave">@descripcion</p>
                        }
                    </div>
                    @if (ViewData["AccionTexto"] is string accionTexto && ViewData["AccionUrl"] is string accionUrl)
                    {
                        <a class="btn btn-primary" href="@accionUrl">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                            @accionTexto
                        </a>
                    }
                </header>

                <partial name="_Alertas" />

                @RenderBody()
            </div>
        </main>
    </div>

    <dialog id="dialogoConfirmar" class="w-[min(26rem,calc(100vw-2rem))] rounded-lg border border-linea bg-white p-0 text-tinta shadow-xl backdrop:bg-tinta/30">
        <form method="dialog" class="p-5">
            <h2 id="confirmarTitulo" class="text-base font-semibold leading-snug"></h2>
            <p id="confirmarDetalle" class="mt-1.5 text-suave"></p>
            <div class="mt-5 flex justify-end gap-2">
                <button type="submit" value="cancelar" class="btn btn-secondary">Cancelar</button>
                <button type="submit" value="ok" id="confirmarBoton" class="btn btn-primary">Aceptar</button>
            </div>
        </form>
    </dialog>

    <script>
        document.getElementById('botonMenu').addEventListener('click', function () {
            var menu = document.getElementById('menu');
            menu.classList.toggle('hidden');
            menu.classList.toggle('flex');
            this.setAttribute('aria-expanded', menu.classList.contains('flex'));
        });

        // Confirmacion propia: un formulario con data-confirmar pregunta antes de enviarse.
        // data-detalle (texto secundario), data-boton (nombre de la accion) y data-peligro="true" son opcionales.
        (function () {
            var dialogo = document.getElementById('dialogoConfirmar');
            var boton = document.getElementById('confirmarBoton');
            var pendiente = null;

            document.addEventListener('submit', function (e) {
                var formulario = e.target;
                if (!formulario.dataset || !formulario.dataset.confirmar) return;
                e.preventDefault();
                if (typeof dialogo.showModal !== 'function') {
                    if (window.confirm(formulario.dataset.confirmar)) formulario.submit();
                    return;
                }
                pendiente = formulario;
                document.getElementById('confirmarTitulo').textContent = formulario.dataset.confirmar;
                document.getElementById('confirmarDetalle').textContent = formulario.dataset.detalle || '';
                boton.textContent = formulario.dataset.boton || 'Aceptar';
                boton.className = 'btn ' + (formulario.dataset.peligro === 'true' ? 'btn-peligro' : 'btn-primary');
                dialogo.showModal();
            });

            dialogo.addEventListener('close', function () {
                var enviar = dialogo.returnValue === 'ok' && pendiente;
                var formulario = pendiente;
                pendiente = null;
                dialogo.returnValue = '';
                if (enviar) formulario.submit();
            });

            // Los filtros que cambian de valor (categoria) se aplican sin pulsar "Buscar".
            document.querySelectorAll('[data-autoenviar]').forEach(function (campo) {
                campo.addEventListener('change', function () { campo.form.requestSubmit(); });
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
