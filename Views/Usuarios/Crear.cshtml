@model UsuarioFormViewModel
@{
    ViewData["Title"] = "Nuevo usuario";
    ViewData["Descripcion"] = "Elija el tipo de usuario: de eso dependen los límites del préstamo.";
}
<partial name="_Formulario" model="Model" />

@section Scripts {
    <script>
        // La etiqueta del campo cambia entre Carnet (lector) y Cargo (bibliotecario).
        const tipos = document.querySelectorAll('input[name="Tipo"][type="radio"]');
        const actualizar = () => {
            const elegido = document.querySelector('input[name="Tipo"]:checked');
            document.getElementById('etiquetaDetalle').textContent = elegido && elegido.value === 'Bibliotecario' ? 'Cargo' : 'Carnet';
        };
        tipos.forEach(t => t.addEventListener('change', actualizar));
        actualizar();
    </script>
}
