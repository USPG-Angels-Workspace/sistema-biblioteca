@model UsuariosIndexViewModel
@{
    ViewData["Title"] = "Usuarios";
    ViewData["Descripcion"] = "Registro de lectores y bibliotecarios, actualización y consulta de datos.";
    ViewData["AccionTexto"] = "+ Nuevo usuario";
    ViewData["AccionUrl"] = Url.Action("Crear")!;
}

<form method="get" class="row g-2 mb-3 align-items-center">
    <div class="col-md-5">
        <input type="text" name="q" value="@Model.Q" class="form-control" placeholder="Buscar por nombre, DPI, correo o carnet" />
    </div>
    <div class="col-md-3">
        <select name="tipo" class="form-select">
            <option value="" selected="@string.IsNullOrEmpty(Model.Tipo)">Todos los tipos</option>
            <option value="Lector" selected="@(Model.Tipo == "Lector")">Lectores</option>
            <option value="Bibliotecario" selected="@(Model.Tipo == "Bibliotecario")">Bibliotecarios</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Buscar</button>
        <a class="btn btn-link" asp-action="Index">Limpiar</a>
    </div>
</form>

<div class="tabla-tarjeta">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th>Tipo</th><th>Nombre</th><th>DPI</th><th>Carnet / Cargo</th><th>Correo</th><th>Teléfono</th><th>Estado</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
            @if (Model.Usuarios.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-secondary py-4">No se encontraron usuarios.</td></tr>
            }
            @foreach (var u in Model.Usuarios)
            {
                <tr>
                    <td>@u.TipoUsuario</td>
                    <td class="fw-semibold">@u.Nombre</td>
                    <td class="text-secondary">@u.Documento</td>
                    <td>@u.Detalle</td>
                    <td>@u.Correo</td>
                    <td>@u.Telefono</td>
                    <td><span class="badge @(u.Activo ? "text-bg-success" : "text-bg-secondary")">@u.EstadoTexto</span></td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@u.Id">Editar</a>
                        <form method="post" asp-action="Eliminar" asp-route-id="@u.Id" class="d-inline"
                              onsubmit="return confirm('¿Eliminar a «@u.Nombre.Replace("'", "\\'")»? Esta acción no se puede deshacer.');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<p class="text-secondary small mt-2">@Model.Usuarios.Count usuario(s)</p>
