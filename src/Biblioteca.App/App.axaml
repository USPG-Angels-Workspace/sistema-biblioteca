<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Biblioteca.App.App"
             RequestedThemeVariant="Light">

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Texto -->
    <Style Selector="TextBlock.titulo">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#14293D" />
    </Style>
    <Style Selector="TextBlock.subtitulo">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#5F6B7A" />
    </Style>
    <Style Selector="TextBlock.etiqueta">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#3B4756" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#B3261E" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Tarjetas -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E3E8EF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Botones -->
    <Style Selector="Button.primario, Button.secundario, Button.peligro">
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primario">
      <Setter Property="Background" Value="#1F4E79" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primario:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2A6199" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.secundario">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#1F4E79" />
      <Setter Property="BorderBrush" Value="#B9C6D6" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.secundario:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#EAF1F8" />
      <Setter Property="Foreground" Value="#1F4E79" />
    </Style>
    <Style Selector="Button.peligro">
      <Setter Property="Background" Value="#B3261E" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.peligro:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C9382F" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primario:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.peligro:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#B8C2CE" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.secundario:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F1F3F6" />
      <Setter Property="Foreground" Value="#9AA5B1" />
    </Style>

    <!-- Menú lateral -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#D6E2EE" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#23425E" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.nav.activo /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2A6199" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- Tablas -->
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="RowHeight" Value="38" />
    </Style>
  </Application.Styles>
</Application>
