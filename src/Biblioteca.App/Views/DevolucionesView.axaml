<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Biblioteca.App.Views.DevolucionesView">
  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,12">
      <TextBlock Classes="titulo" Text="Devoluciones y multas" />
      <TextBlock Classes="subtitulo" Text="Registro de devoluciones, control de vencimientos, cálculo y gestión de multas." />
    </StackPanel>

    <TabControl Grid.Row="1" x:Name="Pestanas" SelectionChanged="Pestanas_Cambio">
      <TabItem Header="Devoluciones pendientes">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0,12,0,0">
          <TextBox x:Name="CajaBusquedaDev" Watermark="Buscar por libro o usuario…" Margin="0,0,0,12" TextChanged="FiltroDev_Cambio" />
          <Border Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True">
            <DataGrid x:Name="TablaDev" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      GridLinesVisibility="Horizontal" CanUserSortColumns="True" CanUserResizeColumns="True"
                      SelectionChanged="TablaDev_SelectionChanged" LoadingRow="TablaDev_LoadingRow">
              <DataGrid.Columns>
                <DataGridTextColumn Header="N°" Binding="{Binding Id}" Width="60" />
                <DataGridTextColumn Header="Libro" Binding="{Binding Libro}" Width="2*" />
                <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="1.5*" />
                <DataGridTextColumn Header="Vence" Binding="{Binding Vence, StringFormat=dd/MM/yyyy}" Width="110" />
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100" />
                <DataGridTextColumn Header="Días atraso" Binding="{Binding DiasAtraso}" Width="110" />
                <DataGridTextColumn Header="Multa estimada" Binding="{Binding MultaEstimada}" Width="140" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="BotonDevolver" Classes="primario" Content="Registrar devolución" Click="Devolver_Click" />
            <TextBlock x:Name="ContadorDev" Classes="subtitulo" VerticalAlignment="Center" Margin="12,0,0,0" />
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Multas">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0,12,0,0">
          <Grid ColumnDefinitions="*,200" Margin="0,0,0,12">
            <TextBox x:Name="CajaBusquedaMulta" Watermark="Buscar por usuario o libro…" TextChanged="FiltroMulta_Cambio" />
            <ComboBox x:Name="ComboEstadoMulta" Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Stretch" SelectionChanged="FiltroMulta_Cambio" />
          </Grid>
          <Border Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True">
            <DataGrid x:Name="TablaMultas" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      GridLinesVisibility="Horizontal" CanUserSortColumns="True" CanUserResizeColumns="True"
                      SelectionChanged="TablaMultas_SelectionChanged" LoadingRow="TablaMultas_LoadingRow">
              <DataGrid.Columns>
                <DataGridTextColumn Header="N°" Binding="{Binding Id}" Width="60" />
                <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="1.5*" />
                <DataGridTextColumn Header="Libro" Binding="{Binding Libro}" Width="2*" />
                <DataGridTextColumn Header="Días atraso" Binding="{Binding DiasAtraso}" Width="110" />
                <DataGridTextColumn Header="Monto" Binding="{Binding MontoTexto}" Width="90" />
                <DataGridTextColumn Header="Generada" Binding="{Binding FechaGeneracion, StringFormat=dd/MM/yyyy}" Width="110" />
                <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" Width="100" />
                <DataGridTextColumn Header="Pagada el" Binding="{Binding FechaPago, StringFormat=dd/MM/yyyy}" Width="110" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="BotonPagar" Classes="primario" Content="Registrar pago" Click="Pagar_Click" />
            <TextBlock x:Name="ResumenMultas" Classes="subtitulo" VerticalAlignment="Center" Margin="12,0,0,0" />
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
