<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Biblioteca.App.Views.DialogoMensajeWindow"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="White" Title="Mensaje">
  <StackPanel Margin="24" Spacing="22">
    <StackPanel Orientation="Horizontal" Spacing="16">
      <Border x:Name="Icono" Width="46" Height="46" CornerRadius="23" VerticalAlignment="Top">
        <TextBlock x:Name="Simbolo" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="24" FontWeight="Bold" Foreground="White" />
      </Border>
      <StackPanel Spacing="4" VerticalAlignment="Center">
        <TextBlock x:Name="Encabezado" FontSize="17" FontWeight="SemiBold" Foreground="#14293D"
                   TextWrapping="Wrap" MaxWidth="340" />
        <TextBlock x:Name="Mensaje" TextWrapping="Wrap" MaxWidth="340" Foreground="#3B4756" />
      </StackPanel>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="BotonCancelar" Classes="secundario" Content="Cancelar" Click="Cancelar_Click" />
      <Button x:Name="BotonAceptar" Classes="primario" Content="Aceptar" IsDefault="True" Click="Aceptar_Click" />
    </StackPanel>
  </StackPanel>
</Window>
