<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Biblioteca.App.Views.InicioView">
  <ScrollViewer>
    <StackPanel Spacing="20">
      <StackPanel Spacing="2">
        <TextBlock Classes="titulo" Text="Bienvenido" />
        <TextBlock x:Name="Fecha" Classes="subtitulo" />
      </StackPanel>

      <UniformGrid Columns="5" x:Name="Tarjetas" />

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="Accesos rápidos" FontSize="17" FontWeight="SemiBold" Foreground="#14293D" />
          <WrapPanel>
            <Button Classes="primario" Content="Registrar un préstamo" Margin="0,0,8,8" Tag="prestamos" Click="Acceso_Click" />
            <Button Classes="primario" Content="Registrar una devolución" Margin="0,0,8,8" Tag="devoluciones" Click="Acceso_Click" />
            <Button Classes="secundario" Content="Consultar libros" Margin="0,0,8,8" Tag="libros" Click="Acceso_Click" />
            <Button Classes="secundario" Content="Consultar usuarios" Margin="0,0,8,8" Tag="usuarios" Click="Acceso_Click" />
            <Button Classes="secundario" Content="Ver reportes" Margin="0,0,8,8" Tag="reportes" Click="Acceso_Click" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Text="Reglas del servicio" FontSize="17" FontWeight="SemiBold" Foreground="#14293D" />
          <TextBlock x:Name="Reglas" TextWrapping="Wrap" Foreground="#3B4756" LineHeight="22" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
