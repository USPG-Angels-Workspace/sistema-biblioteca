<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Biblioteca.App.Views.LibrosView">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,16">
      <TextBlock Classes="titulo" Text="Gestión de libros" />
      <TextBlock Classes="subtitulo" Text="Registro, edición, búsqueda, clasificación y control de disponibilidad." />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,220,Auto" Margin="0,0,0,12">
      <TextBox x:Name="CajaBusqueda" Watermark="Buscar por título, autor, editorial o ISBN…" TextChanged="Filtro_Cambio" />
      <ComboBox x:Name="ComboCategoria" Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Stretch" SelectionChanged="Filtro_Cambio" />
      <CheckBox x:Name="CheckDisponibles" Grid.Column="2" Margin="12,0,0,0" Content="Solo disponibles" IsCheckedChanged="Filtro_Cambio" />
    </Grid>

    <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True">
      <DataGrid x:Name="Tabla" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                GridLinesVisibility="Horizontal" CanUserSortColumns="True" CanUserResizeColumns="True"
                SelectionChanged="Tabla_SelectionChanged" DoubleTapped="Tabla_DoubleTapped">
        <DataGrid.Columns>
          <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="140" />
          <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="2.2*" MinWidth="160" />
          <DataGridTextColumn Header="Autor" Binding="{Binding Autor}" Width="1.5*" MinWidth="120" />
          <DataGridTextColumn Header="Editorial" Binding="{Binding Editorial}" Width="1.2*" MinWidth="100" />
          <DataGridTextColumn Header="Año" Binding="{Binding Anio}" Width="70" />
          <DataGridTextColumn Header="Categoría" Binding="{Binding CategoriaTexto}" Width="100" />
          <DataGridTextColumn Header="Disp." Binding="{Binding CopiasDisponibles}" Width="80" />
          <DataGridTextColumn Header="Total" Binding="{Binding CopiasTotales}" Width="80" />
          <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" Width="115" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="BotonNuevo" Classes="primario" Content="Nuevo libro" Click="Nuevo_Click" />
      <Button x:Name="BotonEditar" Classes="secundario" Content="Editar" Click="Editar_Click" />
      <Button x:Name="BotonEliminar" Classes="peligro" Content="Eliminar" Click="Eliminar_Click" />
      <TextBlock x:Name="Contador" Classes="subtitulo" VerticalAlignment="Center" Margin="12,0,0,0" />
    </StackPanel>
  </Grid>
</UserControl>
