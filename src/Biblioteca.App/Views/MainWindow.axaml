<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Biblioteca.App.Views.MainWindow"
        Title="Sistema de biblioteca"
        Width="1280" Height="780" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9">
  <Grid ColumnDefinitions="230,*">
    <Border Background="#14293D">
      <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="8,10,8,28" Spacing="2">
          <TextBlock Text="Biblioteca" FontSize="26" FontWeight="Bold" Foreground="White" />
          <TextBlock Text="Sistema de gestión" FontSize="13" Foreground="#9DB4CC" />
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Classes="nav" Content="Salir" Click="Salir_Click" />
        <StackPanel Spacing="4">
          <Button x:Name="NavInicio" Classes="nav" Tag="inicio" Content="Inicio" Click="Nav_Click" />
          <Button x:Name="NavLibros" Classes="nav" Tag="libros" Content="Libros" Click="Nav_Click" />
          <Button x:Name="NavUsuarios" Classes="nav" Tag="usuarios" Content="Usuarios" Click="Nav_Click" />
          <Button x:Name="NavPrestamos" Classes="nav" Tag="prestamos" Content="Préstamos" Click="Nav_Click" />
          <Button x:Name="NavDevoluciones" Classes="nav" Tag="devoluciones" Content="Devoluciones y multas" Click="Nav_Click" />
          <Button x:Name="NavReportes" Classes="nav" Tag="reportes" Content="Reportes" Click="Nav_Click" />
        </StackPanel>
      </DockPanel>
    </Border>
    <ContentControl x:Name="Contenido" Grid.Column="1" Margin="28,24,28,24" />
  </Grid>
</Window>
