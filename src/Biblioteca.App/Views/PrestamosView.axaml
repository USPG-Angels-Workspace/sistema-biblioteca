<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Biblioteca.App.Views.PrestamosView">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,16">
      <TextBlock Classes="titulo" Text="Gestión de préstamos" />
      <TextBlock Classes="subtitulo" Text="Registro de préstamos, asignación de libros, fechas de devolución y renovaciones." />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,200" Margin="0,0,0,12">
      <TextBox x:Name="CajaBusqueda" Watermark="Buscar por libro o usuario…" TextChanged="Filtro_Cambio" />
      <ComboBox x:Name="ComboEstado" Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Stretch" SelectionChanged="Filtro_Cambio" />
    </Grid>

    <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True">
      <DataGrid x:Name="Tabla" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                GridLinesVisibility="Horizontal" CanUserSortColumns="True" CanUserResizeColumns="True"
                SelectionChanged="Tabla_SelectionChanged" LoadingRow="Tabla_LoadingRow">
        <DataGrid.Columns>
          <DataGridTextColumn Header="N°" Binding="{Binding Id}" Width="55" />
          <DataGridTextColumn Header="Libro" Binding="{Binding Libro}" Width="2*" MinWidth="170" />
          <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="1.5*" MinWidth="150" />
          <DataGridTextColumn Header="Préstamo" Binding="{Binding FechaPrestamo, StringFormat=dd/MM/yyyy}" Width="110" />
          <DataGridTextColumn Header="Vence" Binding="{Binding FechaVencimiento, StringFormat=dd/MM/yyyy}" Width="110" />
          <DataGridTextColumn Header="Devuelto" Binding="{Binding FechaDevolucion, StringFormat=dd/MM/yyyy}" Width="110" />
          <DataGridTextColumn Header="Renov." Binding="{Binding Renovaciones}" Width="85" />
          <DataGridTextColumn Header="Días atraso" Binding="{Binding DiasAtraso}" Width="110" />
          <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" Width="100" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
      <Button Classes="primario" Content="Nuevo préstamo" Click="Nuevo_Click" />
      <Button x:Name="BotonRenovar" Classes="secundario" Content="Renovar préstamo" Click="Renovar_Click" />
      <TextBlock x:Name="Contador" Classes="subtitulo" VerticalAlignment="Center" Margin="12,0,0,0" />
    </StackPanel>
  </Grid>
</UserControl>
