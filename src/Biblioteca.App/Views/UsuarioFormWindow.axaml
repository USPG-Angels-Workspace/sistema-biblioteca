<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Biblioteca.App.Views.UsuarioFormWindow"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="White">
  <StackPanel Margin="28" Spacing="14">
    <TextBlock x:Name="Encabezado" Classes="titulo" FontSize="22" />

    <Grid ColumnDefinitions="*,12,*">
      <StackPanel>
        <TextBlock Classes="etiqueta" Text="Tipo de usuario *" />
        <ComboBox x:Name="ComboTipo" HorizontalAlignment="Stretch" SelectionChanged="Tipo_Cambio" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock x:Name="EtiquetaDetalle" Classes="etiqueta" Text="Carnet *" />
        <TextBox x:Name="CajaDetalle" MaxLength="60" />
      </StackPanel>
    </Grid>
    <StackPanel>
      <TextBlock Classes="etiqueta" Text="Nombre completo *" />
      <TextBox x:Name="CajaNombre" MaxLength="120" />
    </StackPanel>
    <Grid ColumnDefinitions="*,12,*">
      <StackPanel>
        <TextBlock Classes="etiqueta" Text="Documento (DPI, 13 dígitos) *" />
        <TextBox x:Name="CajaDocumento" MaxLength="20" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Classes="etiqueta" Text="Teléfono *" />
        <TextBox x:Name="CajaTelefono" MaxLength="20" />
      </StackPanel>
    </Grid>
    <StackPanel>
      <TextBlock Classes="etiqueta" Text="Correo electrónico *" />
      <TextBox x:Name="CajaCorreo" MaxLength="120" />
    </StackPanel>
    <CheckBox x:Name="CheckActivo" Content="Usuario activo (puede solicitar préstamos)" IsChecked="True" IsVisible="False" />

    <TextBlock x:Name="Reglas" Classes="subtitulo" TextWrapping="Wrap" />
    <TextBlock x:Name="MensajeError" Classes="error" TextWrapping="Wrap" IsVisible="False" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
      <Button Classes="secundario" Content="Cancelar" IsCancel="True" Click="Cancelar_Click" />
      <Button Classes="primario" Content="Guardar" IsDefault="True" Click="Guardar_Click" />
    </StackPanel>
  </StackPanel>
</Window>
