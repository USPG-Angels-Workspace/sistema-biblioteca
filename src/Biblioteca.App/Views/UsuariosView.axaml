<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Biblioteca.App.Views.UsuariosView">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,16">
      <TextBlock Classes="titulo" Text="Gestión de usuarios" />
      <TextBlock Classes="subtitulo" Text="Registro de lectores y bibliotecarios, actualización y consulta de datos." />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,200" Margin="0,0,0,12">
      <TextBox x:Name="CajaBusqueda" Watermark="Buscar por nombre, DPI, correo o carnet…" TextChanged="Filtro_Cambio" />
      <ComboBox x:Name="ComboTipo" Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Stretch" SelectionChanged="Filtro_Cambio" />
    </Grid>

    <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True">
      <DataGrid x:Name="Tabla" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                GridLinesVisibility="Horizontal" CanUserSortColumns="True" CanUserResizeColumns="True"
                SelectionChanged="Tabla_SelectionChanged" DoubleTapped="Tabla_DoubleTapped">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Tipo" Binding="{Binding TipoUsuario}" Width="120" />
          <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2*" MinWidth="170" />
          <DataGridTextColumn Header="DPI" Binding="{Binding Documento}" Width="140" />
          <DataGridTextColumn Header="Carnet / Cargo" Binding="{Binding Detalle}" Width="1.4*" MinWidth="150" />
          <DataGridTextColumn Header="Correo" Binding="{Binding Correo}" Width="1.6*" MinWidth="210" />
          <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="100" />
          <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" Width="90" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
      <Button Classes="primario" Content="Nuevo usuario" Click="Nuevo_Click" />
      <Button x:Name="BotonEditar" Classes="secundario" Content="Editar" Click="Editar_Click" />
      <Button x:Name="BotonEliminar" Classes="peligro" Content="Eliminar" Click="Eliminar_Click" />
      <TextBlock x:Name="Contador" Classes="subtitulo" VerticalAlignment="Center" Margin="12,0,0,0" />
    </StackPanel>
  </Grid>
</UserControl>
